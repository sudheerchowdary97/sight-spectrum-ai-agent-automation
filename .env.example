# ─────────────────────────────────────────────────────────────────────────────
# Environment configuration (copy to .env and adjust). Never commit real secrets.
# All variables are consumed by invoice_agent.config.Settings.
# ─────────────────────────────────────────────────────────────────────────────

# --- Application ---
ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=true

# --- PostgreSQL + PGVector ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=invoice_agent
POSTGRES_USER=invoice_agent
POSTGRES_PASSWORD=change_me_in_prod

# --- Ollama (LLM provider) ---
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_LLM_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Arize Phoenix (observability) ---
TRACING_ENABLED=true
PHOENIX_COLLECTOR_ENDPOINT=http://phoenix:6006

# --- Mock ERP ---
ERP_BASE_URL=http://mock-erp:8001
ERP_DATA_DIR=data/master

# --- Email ingestion: folder | graph | gmail ---
EMAIL_PROVIDER=folder
EMAIL_REPLAY_DIR=data/inbox
INGESTED_DIR=data/ingested
# Microsoft Graph (when EMAIL_PROVIDER=graph)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX=
# Gmail (when EMAIL_PROVIDER=gmail)
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json

# --- Matching tolerances (Task 6) ---
PRICE_TOLERANCE_PCT=0.02
QTY_TOLERANCE_PCT=0.0
AMOUNT_TOLERANCE_ABS=1.00
