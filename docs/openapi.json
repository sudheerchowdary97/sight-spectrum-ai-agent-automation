{
  "openapi": "3.1.0",
  "info": {
    "title": "Agentic Invoice-to-Payment API",
    "description": "Ingest invoices from email, match against Purchase Orders and Goods Receipts in the ERP, and post Payment Journal entries with a full audit trail and human oversight for exceptions.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Liveness probe",
        "description": "Return service liveness. Extended with dependency checks in later tasks.",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ingest-invoice": {
      "post": {
        "tags": [
          "ingestion"
        ],
        "summary": "Ingest invoice(s) from an upload or the configured mailbox",
        "description": "Ingest invoices.\n\n* If a **file** is uploaded, that document (or ``.eml``) is ingested directly.\n* Otherwise the configured provider (folder replay / Graph / Gmail) is polled;\n  already-seen emails are skipped.",
        "operationId": "ingest_invoice_api_v1_ingest_invoice_post",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ],
              "description": "Max emails to pull when polling the mailbox",
              "title": "Limit"
            },
            "description": "Max emails to pull when polling the mailbox"
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_ingest_invoice_api_v1_ingest_invoice_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/match-po": {
      "post": {
        "tags": [
          "matching"
        ],
        "summary": "Match an extracted invoice against its PO (2-way / 3-way)",
        "description": "Resolve the PO (by number or RAG), pull the Goods Receipt, and match.\n\nReturns a MatchResult classifying the outcome (matched / price_variance /\nqty_variance / partial / missing_po / duplicate) with per-line variances.",
        "operationId": "match_po_api_v1_match_po_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Invoice-Input"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MatchResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/exceptions": {
      "get": {
        "tags": [
          "human-review"
        ],
        "summary": "List queued exceptions",
        "operationId": "list_exceptions_api_v1_exceptions_get",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/ExceptionStatus"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ExceptionItem"
                  },
                  "title": "Response List Exceptions Api V1 Exceptions Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/exceptions/{exception_id}": {
      "get": {
        "tags": [
          "human-review"
        ],
        "summary": "Fetch one exception",
        "operationId": "get_exception_api_v1_exceptions__exception_id__get",
        "parameters": [
          {
            "name": "exception_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Exception Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExceptionItem"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/exceptions/{exception_id}/approve": {
      "post": {
        "tags": [
          "human-review"
        ],
        "summary": "Approve an exception (posts the Payment Journal)",
        "operationId": "approve_exception_api_v1_exceptions__exception_id__approve_post",
        "parameters": [
          {
            "name": "exception_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Exception Id"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApproveRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExceptionItem"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/exceptions/{exception_id}/reject": {
      "post": {
        "tags": [
          "human-review"
        ],
        "summary": "Reject an exception",
        "operationId": "reject_exception_api_v1_exceptions__exception_id__reject_post",
        "parameters": [
          {
            "name": "exception_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Exception Id"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RejectRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExceptionItem"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/post-payment-journal": {
      "post": {
        "tags": [
          "payment"
        ],
        "summary": "Post a Payment Journal entry for an approved invoice",
        "description": "Post the AP Payment Journal for an approved invoice via the ERP.\n\nReturns the posted entry; a duplicate (already-posted invoice) yields 409.",
        "operationId": "post_payment_journal_api_v1_post_payment_journal_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Invoice-Input"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentJournalEntry"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/apply-remittance": {
      "post": {
        "tags": [
          "accounts-receivable"
        ],
        "summary": "Match a customer remittance to an open AR item and apply cash",
        "description": "Apply an inbound remittance against the referenced open AR item.",
        "operationId": "apply_remittance_api_v1_apply_remittance_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Remittance"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RemittanceResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/audit-log": {
      "get": {
        "tags": [
          "audit"
        ],
        "summary": "Retrieve the decision audit trail",
        "description": "Return audit records, newest last, optionally filtered.",
        "operationId": "get_audit_log_records_api_v1_audit_log_get",
        "parameters": [
          {
            "name": "correlation_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by run correlation id",
              "title": "Correlation Id"
            },
            "description": "Filter by run correlation id"
          },
          {
            "name": "invoice_number",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by invoice number",
              "title": "Invoice Number"
            },
            "description": "Filter by invoice number"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ],
              "description": "Return only the most recent N",
              "title": "Limit"
            },
            "description": "Return only the most recent N"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AuditRecord"
                  },
                  "title": "Response Get Audit Log Records Api V1 Audit Log Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApproveRequest": {
        "properties": {
          "actor": {
