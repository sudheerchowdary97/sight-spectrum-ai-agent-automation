        },
        "type": "object",
        "title": "ApproveRequest"
      },
      "AuditRecord": {
        "properties": {
          "record_id": {
            "type": "string",
            "title": "Record Id"
          },
          "correlation_id": {
            "type": "string",
            "title": "Correlation Id"
          },
          "decision": {
            "$ref": "#/components/schemas/DecisionType"
          },
          "actor": {
            "type": "string",
            "title": "Actor",
            "default": "agent"
          },
          "invoice_number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Invoice Number"
          },
          "source_email_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Email Id"
          },
          "detail": {
            "additionalProperties": true,
            "type": "object",
            "title": "Detail"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          }
        },
        "additionalProperties": false,
